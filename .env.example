# Copy to `.env` and uncomment what you need.  compose.yaml has a default for
# every value below, so an empty `.env` means "the usual locations".

# Your Hermes home: the directory holding state.db, cron/, skills/, memories/.
# HERMES_HOME_PATH=/home/you/.hermes

# Your Obsidian vault.  Leave it unset if you have none -- the vault domain
# reports the source MISSING rather than failing.
# VAULT_PATH=/home/you/Obsidian

# Which host port to publish the page on (the container listens on 8087).
# PORTAL_PORT=8087

# What this instance calls itself in its header and page title.  Set it to the
# machine's name: two portals render identically otherwise.
# PORTAL_LABEL=workstation

# Optional code graph for the graph domain.
# GRAPH_DB=/home/you/.hermes/.code-review-graph/graph.db

# Timezone for the rendered timestamps.
# TZ=UTC
