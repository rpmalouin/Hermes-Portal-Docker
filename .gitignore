# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build output
build/
dist/
*.egg
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/
*.swp

# Secrets and local state.  Nothing in this list is in the repository today; the
# entries are here so that the first time someone runs a copy against a real
# deployment, a key, a token file or a live database cannot be committed by habit.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.p8
id_rsa*
id_ed25519*
*_smbcred*
credential*.json
service-account*.json
.gpg/

# Live stores and their journals: the portal reads these, the repository must not
# carry them (a Hermes state.db holds one's whole session history).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Runtime output
logs/
reports/
*.log
*.jsonl

# The compose file's favourites document, written into ./state on first run.
state/

# Added by code-review-graph
.code-review-graph/

# Other agents' per-machine configs and the code-review-graph installer's output.
# They are installed here (code-review-graph install) and point at absolute paths on
# this machine, and they carry skill trees of uncertain provenance, so they stay out
# of the public repository and remain on disk untouched.
.claude/
.codebuddy/
.cursorrules
.gemini/
.github/code-review-graph*
.github/instructions/
.kiro/
.mcp.json
.qoder/
.windsurfrules
AGENTS.md
CLAUDE.md
CODEBUDDY.md
GEMINI.md
QODER.md
opencode.jsonc

# The running decisions log for this checkout.  Read first each session, kept out of
# the repository so it never dirties `git status`: the tracked README is the behaviour
# reference, MEMORY.md records what the box did and what was decided, by date.
MEMORY.md
